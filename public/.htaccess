# Can Suyu — Apache / Hostinger yapılandırması

# --- SPA yönlendirme (Vue Router history mode) ---
# Fiziksel dosya/klasör yoksa tüm istekleri index.html'e ver ki
# doğrudan URL ve sayfa yenileme 404 vermesin; yönlendirmeyi Vue Router yapar.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ /index.html [L]
</IfModule>

# --- Önbellek ---
# index.html önbelleğe alınmaz → yeni dağıtım anında etkili olur (eski bundle sorununu önler).
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Hash'li statik dosyalar uzun süre önbelleğe alınabilir (isim değişince zaten yenilenir).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
